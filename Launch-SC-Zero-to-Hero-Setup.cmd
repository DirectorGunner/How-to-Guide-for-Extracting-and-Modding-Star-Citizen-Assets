            $elapsedValue = 0.0
            try { $elapsedValue = [double]$r.ElapsedSeconds } catch { $elapsedValue = 0.0 }
            [void]$list.Add([ordered]@{
                id = [string]$r.Id
                name = [string]$r.Name
                elapsedSeconds = $elapsedValue
                status = $status
                reason = [string]$r.Reason
            })
        }
    } catch { }
    return @($list.ToArray())
}

