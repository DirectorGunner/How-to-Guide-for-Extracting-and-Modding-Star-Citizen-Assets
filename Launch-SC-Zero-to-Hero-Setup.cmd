emit('PACKAGE_ROOT', getattr(root, 'name', '') if root is not None else '')
emit('GEOMETRY_STATUS', geometry_status)
emit('MATERIALS_STATUS', materials_status)
emit('ADDON_STATUS', addon_status)
emit('ADDON_REASON', addon_reason)
